# Core application
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Tbilisi
APP_SECRET_KEY=change_me

# Checker PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/promocode_checker

# Promo settings
PROMOCODE_TTL_DAYS=30
FRAUD_MATCH_WINDOW_HOURS=2

# ERP access
# Local / demo: proxy (POST /api/query + Bearer). Put PROXY_API_TOKEN from the Proxy API project.
# Server prod: prefer ERP_ACCESS_MODE=direct + FIREBIRD_* (see infra/.env.prod.example).
ERP_ACCESS_MODE=proxy
PROXY_API_URL=http://178.63.72.227:8010
PROXY_API_TOKEN=
PROXY_API_TIMEOUT=60
PROXY_API_MAX_RETRIES=3

# Direct Firebird (server-prod; leave empty locally when using proxy)
FIREBIRD_DSN=
FIREBIRD_USER=
FIREBIRD_PASSWORD=

# Coffee matching rules
COFFEE_BEANS_GROUP_IDS=11077,16276,16279
COFFEE_BEANS_PARAM_ID=2
COFFEE_BEANS_PARAM_VALUE_ID=4
# Paid STORZAKAZDT statuses (granit default)
ERP_PAID_STATUSES=1,2,3,5

# Cashier session
DEFAULT_POINT_ID=shop_01
CASHIER_SESSION_HEARTBEAT_SECONDS=60

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_me_viewer

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_NOTIFY_OK=0
TELEGRAM_DEDUP_WINDOW_SECONDS=900

# Frontend / desktop shell
FRONTEND_BASE_URL=http://localhost:8000
STATIC_DIR=
DESKTOP_DEFAULT_POINT_ID=shop_01

# Railway / production examples
RAILWAY_PUBLIC_DOMAIN=
PUBLIC_HTTP_PORT=8000
