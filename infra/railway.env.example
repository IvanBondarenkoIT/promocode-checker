# Railway demo variables (set in Railway dashboard or via CLI).
APP_ENV=railway
APP_SECRET_KEY=change_me_railway_secret

# Railway Postgres plugin injects DATABASE_URL automatically (postgres://...).

STATIC_DIR=/app/static
FRONTEND_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
RAILWAY_PUBLIC_DOMAIN=

ERP_ACCESS_MODE=mock
AUTO_SEED_PROMOCODES=1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_me_viewer

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

PUBLIC_HTTP_PORT=8000
