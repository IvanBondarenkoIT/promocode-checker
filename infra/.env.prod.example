# Copy to infra/.env.prod on the server (C:\Projects\promocode-checker\infra\.env.prod) and fill secrets.
# CRITICAL to change: APP_SECRET_KEY, POSTGRES_PASSWORD, ADMIN_PASSWORD, VIEWER_PASSWORD,
# FIREBIRD_PASSWORD, TELEGRAM_BOT_TOKEN, TELEGRAM_ALERT_CHAT_ID.
APP_ENV=prod
APP_SECRET_KEY=change_me_prod_secret

POSTGRES_DB=promocode_checker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password

PUBLIC_HTTP_PORT=8020
# Same Windows Server as RDP cashiers → http://127.0.0.1:8020
# Cashiers on other PCs → http://<server-hostname-or-LAN-IP>:8020
FRONTEND_BASE_URL=http://127.0.0.1:8020

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_me_viewer

# Server-prod: same Firebird the local proxy uses (C:\FirebirdAPI\firebird-db-proxy\.env).
# Docker reaches the Windows host via host.docker.internal (see extra_hosts in compose).
# Match proxy: DB_HOST=127.0.0.1 DB_PORT=3050 DB_NAME=C:\db\GEORGIA.GDB — not 3055 / DK_GEORGIA.
ERP_ACCESS_MODE=direct
FIREBIRD_DSN=host.docker.internal/3050:C:/db/GEORGIA.GDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=
# Leave EMPTY in Linux Docker (uses libfbclient2). NEVER put the .GDB database file here.
# The GDB path belongs in FIREBIRD_DSN (as the remote DB name), not in LIBRARY_PATH.
FIREBIRD_LIBRARY_PATH=
ERP_PAID_STATUSES=1,2,3,5
COFFEE_BEANS_GROUP_IDS=11077,16276,16279
# monitor for go-live rehearsal (alerts only); switch to enforce when ready to auto-close
PROMO_ENFORCEMENT_MODE=monitor
PROMO_MIN_COFFEE_KG=2.0
RECONCILE_INTERVAL_SECONDS=900
# Optional fallback when direct fails (leave token empty to disable fallback)
PROXY_API_URL=http://178.63.72.227:8010
PROXY_API_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_NOTIFY_OK=0
TELEGRAM_DAY_START_HOUR=10
TELEGRAM_DAY_START_MINUTE=0
TELEGRAM_EOD_HOUR=22
TELEGRAM_EOD_MINUTE=0

AUTO_SEED_PROMOCODES=0
